[resource]
script = ExtResource("1")
display_name = "Марк, Странник"
wander_speed = 72.0
flee_speed = 120.0
wander_radius = 260.0
notice_player_distance = 105.0
interaction_distance = 92.0
introduction = "Зови меня Марк. Хожу между укрытиями, меняю припасы и собираю слухи."
familiar_greeting = "Снова встретились. Есть новости или хочешь взглянуть на припасы?"
rumor_lines = Array[String](["У дороги видели дом, в котором мог остаться нетронутый тайник.", "После заката волки подходят к тропам ближе обычного.", "Если ищешь лекарства, осматривай жилые дома и старые медпункты."])
